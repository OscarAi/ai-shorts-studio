# Copy this file to ".env" (same folder) and fill in what you use.
# .env is git-ignored: your keys never go to GitHub. Never paste keys anywhere else.

# Free AI services for "Run with AI" (any one is enough; more = automatic backup).
# The order they are tried in, and their terms, are in config/ai.yaml.
# Gemini (best free quality):  https://aistudio.google.com/apikey   (no billing account!)
GEMINI_API_KEY=
# Groq (fast, open models):     https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models):     https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: store data somewhere else (default is the ./data folder)
# SHORTS_DATA_DIR=D:\shorts_data
